# Never commit real study units. authority.md files contain quotes attributed
# to named instructors, and raw/ contains copyrighted course material.
# (study/ at the repo root is the skill itself and IS committed.)
**/raw/*
!examples/**/raw/.gitkeep

# Real state files
mastery.json
log.md
unit.md
config.md
.ingest.json

# but keep the fabricated examples
!examples/**/mastery.json
!examples/**/log.md
!examples/**/unit.md
!examples/**/.ingest.json

.DS_Store
TASKS.md

